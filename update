        Update <?= $type === "developer" ? "Developer" : "Project" ?>
    </h1>

    <?php if ($error !== ""): ?>
        <p class="error"><?= h($error) ?></p>
    <?php endif; ?>

    <form method="post" action="update.php">

        <input type="hidden" name="type" value="<?= h($type) ?>">
        <input type="hidden" name="id" value="<?= h($id) ?>">

        <?php if ($type === "developer"): ?>

            <label for="developer_name">Developer Name</label>

            <input
                id="developer_name"
                type="text"
                name="developer_name"
                value="<?= h($record["developer_name"]) ?>"
                required
            >

            <label for="email">Email</label>

            <input
                id="email"
                type="email"
                name="email"
                value="<?= h($record["email"]) ?>"
                required
            >

        <?php else: ?>

            <label for="project_name">Project Name</label>

            <input
                id="project_name"
                type="text"
                name="project_name"
                value="<?= h($record["project_name"]) ?>"
                required
            >

            <label for="description">Description</label>

            <input
                id="description"
                type="text"
                name="description"
                value="<?= h($record["description"]) ?>"
            >

            <label for="developer_id">Assigned Developer</label>

            <select id="developer_id" name="developer_id" required>

                <?php foreach ($developers as $developer): ?>
                    <option
                        value="<?= h($developer["developer_id"]) ?>"
                        <?= (int)$record["developer_id"]
                            === (int)$developer["developer_id"]
                            ? "selected" : "" ?>
                    >
                        <?= h($developer["developer_name"]) ?>
                    </option>
                <?php endforeach; ?>

            </select>

        <?php endif; ?>

        <p>
            <button type="submit" name="save">Save Changes</button>
            <a href="index.php">Cancel</a>
        </p>

    </form>

</body>
