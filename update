<?php
require_once __DIR__ . "/dbconfig.php";

function h($value) {
    return htmlspecialchars(
        (string)$value,
        ENT_QUOTES,
        "UTF-8"
    );
}

$type = $_POST["type"] ?? $_GET["type"] ?? "";

$id = filter_var(
    $_POST["id"] ?? $_GET["id"] ?? "",
    FILTER_VALIDATE_INT
);

$error = "";

if (!in_array($type, ["developer", "project"], true)
    || !$id || $id < 1) {
    exit("Invalid record. <a href='index.php'>Return to main page</a>");
}

if ($_SERVER["REQUEST_METHOD"] === "POST"
    && isset($_POST["save"])) {

    try {
        if ($type === "developer") {
            $name = trim($_POST["developer_name"] ?? "");
            $email = trim($_POST["email"] ?? "");

            if ($name === ""
                || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
                $error = "Enter a developer name and valid email.";
            } else {
                $stmt = $conn->prepare(
                    "UPDATE Developers
                     SET developer_name = ?, email = ?
                     WHERE developer_id = ?"
                );

                $stmt->bind_param("ssi", $name, $email, $id);
                $stmt->execute();
                $stmt->close();

                header("Location: index.php?message=updated");
                exit;
            }
        } else {
            $name = trim($_POST["project_name"] ?? "");
            $description = trim($_POST["description"] ?? "");

            $developerId = filter_var(
                $_POST["developer_id"] ?? "",
                FILTER_VALIDATE_INT
            );

            if ($name === "" || !$developerId || $developerId < 1) {
                $error = "Enter a project name and select a developer.";
            } else {
                $stmt = $conn->prepare(
                    "UPDATE Projects
                     SET project_name = ?,
                         description = ?,
                         developer_id = ?
                     WHERE project_id = ?"
                );

                $stmt->bind_param(
                    "ssii",
                    $name,
                    $description,
                    $developerId,
                    $id
                );

                $stmt->execute();
                $stmt->close();

                header("Location: index.php?message=updated");
                exit;
            }
        }
    } catch (mysqli_sql_exception $e) {
        $error = "Update failed. Check the entered information. "
               . $e->getMessage();
    }
}
if ($type === "developer") {
    $stmt = $conn->prepare(
        "SELECT developer_id, developer_name, email
         FROM Developers
         WHERE developer_id = ?"
    );
} else {
    $stmt = $conn->prepare(
        "SELECT project_id, project_name, description, developer_id
         FROM Projects
         WHERE project_id = ?"
    );
}

$stmt->bind_param("i", $id);
$stmt->execute();

$record = $stmt->get_result()->fetch_assoc();
$stmt->close();

if (!$record) {
    exit("Record not found. <a href='index.php'>Return to main page</a>");
}

$developers = [];

if ($type === "project") {
    $developers = $conn->query(
        "SELECT developer_id, developer_name
         FROM Developers
         ORDER BY developer_name"
    )->fetch_all(MYSQLI_ASSOC);

    if (!$developers) {
        exit("Add a developer first. <a href='index.php'>Return</a>");
    }
}
?>

