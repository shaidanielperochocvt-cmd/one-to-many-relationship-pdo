<?php
require_once __DIR__ . "/dbconfig.php";

if ($_SERVER["REQUEST_METHOD"] !== "POST") {
    header("Location: index.php");
    exit;
}
$type = $_POST["type"] ?? "";

$id = filter_var(
    $_POST["id"] ?? "",
    FILTER_VALIDATE_INT
);

if (!in_array($type, ["developer", "project"], true)
    || !$id || $id < 1) {
    exit("Invalid delete request. <a href='index.php'>Return</a>");
}

try {
    $conn->begin_transaction();

    if ($type === "developer") {
        $stmt = $conn->prepare(
            "DELETE FROM Projects WHERE developer_id = ?"
        );

        $stmt->bind_param("i", $id);
        $stmt->execute();
        $stmt->close();
        $stmt = $conn->prepare(
            "DELETE FROM Developers WHERE developer_id = ?"
        );

        $stmt->bind_param("i", $id);
        $stmt->execute();
        $stmt->close();

    } else {
        $stmt = $conn->prepare(
            "DELETE FROM Projects WHERE project_id = ?"
        );

        $stmt->bind_param("i", $id);
        $stmt->execute();
        $stmt->close();
    }

    $conn->commit();

    header("Location: index.php?message=deleted");
    exit;

} catch (mysqli_sql_exception $e) {
    $conn->rollback();

    http_response_code(500);

    exit(
        "Delete failed. Check the database structure. Details: " .
        htmlspecialchars($e->getMessage(), ENT_QUOTES, "UTF-8")
    );
}
?>
