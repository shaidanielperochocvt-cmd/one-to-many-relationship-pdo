<?php
require_once __DIR__ . "/dbconfig.php";
$message = "";
$messageType = "success";

if (isset($_GET["message"])) {
    $messages = [
        "developer_added" => "Developer added successfully!",
        "project_added" => "Project added successfully!",
        "updated" => "Record updated successfully!",
        "deleted" => "Record deleted successfully!"
    ];

    if (isset($messages[$_GET["message"]])) {
        $message = $messages[$_GET["message"]];
    }
}
if ($_SERVER["REQUEST_METHOD"] === "POST"
    && isset($_POST["add_developer"])) {

    $name = trim($_POST["developer_name"] ?? "");
    $email = trim($_POST["email"] ?? "");

    if ($name === "" || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $message = "Enter a developer name and valid email.";
        $messageType = "error";
    } else {
        try {
            $stmt = $conn->prepare(
                "INSERT INTO Developers (developer_name, email)
                 VALUES (?, ?)"
            );

            $stmt->bind_param("ss", $name, $email);
            $stmt->execute();
            $stmt->close();

            header("Location: index.php?message=developer_added");
            exit;
        } catch (mysqli_sql_exception $e) {
            $message = "Could not add developer. Check your database.";
            $messageType = "error";
        }
    }
}

if ($_SERVER["REQUEST_METHOD"] === "POST"
    && isset($_POST["add_project"])) {

    $projectName = trim($_POST["project_name"] ?? "");
    $description = trim($_POST["description"] ?? "");
    $developerId = filter_var(
        $_POST["developer_id"] ?? "",
        FILTER_VALIDATE_INT
    );

    if ($projectName === "" || !$developerId || $developerId < 1) {
        $message = "Enter a project name and select a developer.";
        $messageType = "error";
    } else {
        try {
            $stmt = $conn->prepare(
                "INSERT INTO Projects
                 (project_name, description, developer_id)
                 VALUES (?, ?, ?)"
            );

            $stmt->bind_param(
                "ssi",
                $projectName,
                $description,
                $developerId
            );

            $stmt->execute();
            $stmt->close();

            header("Location: index.php?message=project_added");
            exit;
        } catch (mysqli_sql_exception $e) {
            $message = "Could not add project. Check the selected developer.";
            $messageType = "error";
        }
    }
}

$developers = $conn->query(
    "SELECT developer_id, developer_name, email
     FROM Developers
     ORDER BY developer_id"
)->fetch_all(MYSQLI_ASSOC);

$projects = $conn->query(
    "SELECT p.project_id, p.project_name, p.description,
            d.developer_name
     FROM Projects p
     INNER JOIN Developers d
        ON p.developer_id = d.developer_id
     ORDER BY p.project_id"
)->fetch_all(MYSQLI_ASSOC);

function h($value) {
    return htmlspecialchars(
        (string)$value,
        ENT_QUOTES,
        "UTF-8"
    );
}
